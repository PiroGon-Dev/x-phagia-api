# Database
DATABASE_URL=sqlite:///../database/pgdevice.db

# Security
SECRET_KEY=PGDEVICESECRETKEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Storage
DATA_PATH=./data
MAX_FILE_SIZE=104857600  # 100MB

# Device Configuration
DEVICE_SERIAL_NUMBER=CM5-001
DEVICE_NAME=Medical Device CM5
FIRMWARE_VERSION=1.0.0
DEVICE_IP=192.168.1.100

# Kiosk Mode
KIOSK_ENABLED=true
KIOSK_PIN_HASH=$2b$12$

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/medical_device.log